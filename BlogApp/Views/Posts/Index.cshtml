@model List<Post>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Posts - Blog</title>
</head>
<body>
	<h1>Posts Index</h1>
	@foreach (var post in Model)
	{
		<div>
			<h2>@post.Title</h2>
			<p>@post.Content</p>
			 
		</div>
	}
</body>
</html>
